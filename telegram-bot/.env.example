# ── Required ──────────────────────────────────────────────────────────────────
# Your bot token from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Deployment ────────────────────────────────────────────────────────────────
# For Render: set to your service's public HTTPS URL (no trailing slash)
# For local development: leave this EMPTY to use polling mode
WEBHOOK_URL=

# Port the webhook server listens on (Render sets PORT automatically)
PORT=8443

# ── Admins ────────────────────────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs that have full admin access
# Find your user ID by messaging @userinfobot
ADMIN_IDS=123456789

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# Auto-reply to private messages (true/false)
AUTO_REPLY_ENABLED=true
AUTO_REPLY_TEXT=👋 Thanks for your message! A team member will get back to you soon.

# Welcome message for new group members
# Placeholders: {first_name}, {username}, {group_name}
WELCOME_ENABLED=true
WELCOME_TEXT=👋 Welcome to {group_name}, {first_name}! Glad you're here.\n\nPlease read the group rules before posting. Enjoy your stay! 🎉
